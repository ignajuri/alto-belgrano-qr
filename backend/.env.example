# Copiar a .env (local) o cargar como variables de entorno en Render.
# NUNCA versionar el .env real.

NODE_ENV=production
PORT=3000

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://fosfmikcaziutdgfednc.supabase.co
# SERVICE KEY: bypassea RLS. Solo en el backend, jamás en el frontend.
SUPABASE_SERVICE_KEY=

# ── Sesiones ────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRACION=12h

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Usar un dominio propio verificado con SPF, DKIM y DMARC.
# onboarding@resend.dev solo entrega a la casilla dueña de la cuenta.
EMAIL_REMITENTE=Alto Belgrano <invitaciones@tudominio.com>
# Casilla que recibe las respuestas de los invitados. Tiene que existir de
# verdad: un Reply-To que rebota empeora la reputación del dominio.
# Si no tenés una, dejalo vacío.
EMAIL_RESPUESTA=
EMAIL_INTERVALO_MS=600

# ── CORS ────────────────────────────────────────────────────────────────────
# Lista separada por comas. Agregar http://localhost:5173 solo en desarrollo.
CORS_ORIGENES=https://qr.altobelgrano.com.ar,https://alto-belgrano-qr.vercel.app

# ── Ventana de validez del QR (horas respecto al día del evento) ────────────
QR_HORAS_ANTES=12
QR_HORAS_DESPUES=24

# ── Bloqueo de cuenta por intentos fallidos ─────────────────────────────────
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# ── Subida de archivos ──────────────────────────────────────────────────────
MAX_ARCHIVO_BYTES=5242880
